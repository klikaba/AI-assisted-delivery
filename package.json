{
  "name": "agency-platform",
  "version": "0.7.0",
  "description": "Enterprise Agentic Delivery Platform - A portable, role-based Agentic SDLC configuration",
  "license": "Apache-2.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/klikaba/AI-assisted-delivery.git"
  },
  "homepage": "https://github.com/klikaba/AI-assisted-delivery",
  "type": "commonjs",
  "scripts": {
    "agency": "node scripts/agency.js",
    "agency:mcp": "node scripts/agency-mcp.js",
    "agency:cli": "node scripts/agency-cli.js",
    "demo:sleepops": "node demo/sleepops-console/server.js",
    "demo:sleepops:test": "HOST=127.0.0.1 PORT=4317 SLEEPOPS_STRICT_PORT=1 node demo/sleepops-console/server.js",
    "lint:demo:sleepops": "node scripts/lint-demo-sleepops.js",
    "test:demo:sleepops": "node --test demo/sleepops-console/test/*.test.mjs",
    "test:e2e:sleepops": "playwright test --pass-with-no-tests",
    "test:e2e:sleepops:ui": "playwright test --ui --pass-with-no-tests",
    "install:browsers": "playwright install chromium",
    "doctor": "node scripts/doctor.js",
    "doctor:live": "AGENCY_DOCTOR_LIVE=1 node scripts/doctor.js",
    "doctor:demo": "node scripts/demo-preflight.js",
    "e2e:agent": "AGENCY_E2E_AGENT=1 node scripts/e2e/opencode-agent-smoke.js",
    "sim:planning": "node scripts/simulate/planning.js --json",
    "sim:pm-sync": "node scripts/simulate/pm-sync.js --json",
    "sim:dev-complete": "node scripts/simulate/dev-complete.js --json",
    "sim:qa-pass": "node scripts/simulate/qa-verify.js --pass --json",
    "sim:review-pass": "node scripts/simulate/review.js --pass --json",
    "sim:security-pass": "node scripts/simulate/security-audit.js --pass --json",
    "sim:release": "node scripts/simulate/release.js --json",
    "sim:scm-pr": "node scripts/simulate/scm-pr.js --json",
    "sim:trace-planning": "AGENCY_TRACE=1 node scripts/simulate/planning.js --execute --json",
    "test:update-traces": "node scripts/update-traces.js",
    "live-e2e": "node scripts/live-e2e/run.js",
    "lint:prompts": "node scripts/prompt-lint.js",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2"
  }
}
