# Example environment variables (do not put real secrets in git).
#
# The exact variables required for Atlassian auth depend on the MCP server you run:
# https://github.com/atlassian/atlassian-mcp-server
#
# MCP endpoint URLs (optional; only needed if you run your own MCP server)
# JIRA_MCP_URL=http://localhost:7010/mcp
# CONFLUENCE_MCP_URL=http://localhost:7020/mcp

# Confluence space for specs (used by prompts as a required “safe default”)
CONFLUENCE_SPACE_KEY=ENG
