# Example environment variables (do not put real secrets in git).
#
# =============================================================================
# ATLASSIAN MODE (tracker.mode = "atlassian")
# =============================================================================
# Default integration uses Atlassian Cloud REST APIs via the Agency backend (used by Agency MCP tools).
# Required:
# - ATLASSIAN_SITE: https://<your-domain>.atlassian.net
# - ATLASSIAN_EMAIL: Atlassian account email
# - ATLASSIAN_API_TOKEN: Atlassian API token
#
# Optional overrides:
# - JIRA_BASE_URL: override Jira base URL (defaults to ATLASSIAN_SITE)
# - CONFLUENCE_BASE_URL: override Confluence base URL (defaults to ATLASSIAN_SITE/wiki)
ATLASSIAN_SITE=https://your-domain.atlassian.net
ATLASSIAN_EMAIL=you@company.com
ATLASSIAN_API_TOKEN=your-api-token

# Confluence space for specs (required only when docs.provider="atlassian")
CONFLUENCE_SPACE_KEY=ENG

# =============================================================================
# DOCS PROVIDERS (docs.provider)
# =============================================================================
# Docs are optional and vendor-agnostic; default is repo-backed markdown.
# - docs.provider="repo": write specs under AGENCY_DOCS_DIR (or docs.repo.dir in config)
# - docs.provider="atlassian": use Confluence (requires Confluence env vars above)
# - docs.provider="none": disable docs tools
AGENCY_DOCS_PROVIDER=repo
AGENCY_DOCS_DIR=docs/agency

# If you prefer MCP for Atlassian instead of REST, set in .agency-project.json:
#   "tracker": { "mode": "atlassian", "atlassian": { "backend": "mcp", "mcp_url": "..." } }

# =============================================================================
# GITHUB MODE (tracker.mode = "github")
# =============================================================================
# Requires: gh CLI installed and authenticated (gh auth login)
# No environment variables required - uses gh CLI authentication

# =============================================================================
# LINEAR MODE (tracker.mode = "linear")
# =============================================================================
# Linear uses GraphQL API.
# Required:
# - LINEAR_API_KEY: Personal API key (recommended)
LINEAR_API_KEY=your-linear-api-key
# Optional:
# - LINEAR_ACCESS_TOKEN: OAuth access token (if using OAuth; takes precedence over LINEAR_API_KEY)
#
# Note: Linear mode expects the `ai-state:*` workflow labels to exist in the workspace.
# Create them in Linear (Workspace Settings → Labels).

# =============================================================================
# STANDALONE MODE (tracker.mode = "standalone")
# =============================================================================
# No environment variables required - works offline
