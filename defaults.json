{
  "version": "1.0",
  "models": {
    "default": "openai/gpt-5.4-mini",
    "agents": {
      "product_owner": "openai/gpt-5.4-mini",
      "planning": "openai/gpt-5.4-mini",
      "architecture": "openai/gpt-5.4-mini",
      "developer": "openai/gpt-5.4-mini",
      "reviewer": "openai/gpt-5.4-mini",
      "security": "openai/gpt-5.4-mini",
      "devops": "openai/gpt-5.4-mini",
      "qa": "openai/gpt-5.4-mini",
      "pm": "openai/gpt-5.4-mini"
    }
  },
  "tracker": {
    "mode": "atlassian",
    "atlassian": {
      "backend": "api"
    }
  },
  "docs": {
    "provider": "repo",
    "repo": {
      "dir": "docs/agency"
    }
  },
  "scm": {
    "provider": "none"
  },
  "tms": {
    "provider": "none",
    "testrail": {
      "project_id": null,
      "suite_id": null,
      "section_id": null,
      "suite_strategy": "component"
    }
  },
  "agents": {
    "product_owner": { "enabled": true },
    "planning": { "enabled": true },
    "architecture": { "enabled": true },
    "developer": { "enabled": true },
    "reviewer": { "enabled": true, "tools": { "edit": false, "bash": true } },
    "security": { "enabled": true },
    "devops": { "enabled": true },
    "qa": { "enabled": true },
    "pm": { "enabled": true }
  },
  "tooling": {
    "test_command": null,
    "lint_command": null,
    "build_command": null,
    "branch_pattern": "feature/{ticket}",
    "commit_pattern": "{ticket}: {message}"
  },
  "workflow": {
    "skip_states": [],
    "labels": {
      "ready_for_plan": "ai-state:ready-for-plan",
      "plan_review": "ai-state:plan-review",
      "approved": "ai-state:approved",
      "in_qa": "ai-state:in-qa",
      "verified": "ai-state:verified",
      "reviewed": "ai-state:reviewed",
      "review_fail": "ai-state:review-fail",
      "security_pass": "ai-state:security-pass",
      "security_fail": "ai-state:security-fail"
    },
    "gates": {
      "spec_approval": true,
      "code_review": true,
      "qa_verification": true,
      "security_audit": false,
      "test_cases": true
    }
  },
  "opencode": {
    "permission": {
      "edit": "ask",
      "bash": "ask"
    },
    "vendor_mcp": {
      "atlassian": {
        "enabled": false,
        "url": "https://mcp.atlassian.com/v1/mcp"
      }
    }
  }
}
