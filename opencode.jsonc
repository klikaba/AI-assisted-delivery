{
  "$schema": "https://opencode.ai/config.json",

  "permission": {
    "edit": "ask",
    "bash": "ask"
  },

  "mcp": {
    "atlassian": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://mcp.atlassian.com/v1/sse"
      ],
      "enabled": true
    }
  },

  "agent": {
    "planning": { "disable": true },
    "dev": { "disable": true },
    "review": { "disable": true },
    "qa": { "disable": true },
    "build": { "disable": true },
    "plan": { "disable": true },

    "Product Owner Agent": {
      "model": "opencode/glm-4.7-free",
      "description": "Refines backlog items and ensures business clarity.",
      "prompt": "{file:./prompts/product.md}"
    },
    "Planning Agent": {
      "model": "openai/gpt-5.2",
      "description": "Converts requirements into Architecture and Plans.",
      "prompt": "{file:./prompts/planning.md}"
    },
    "Architecture Agent": {
      "model": "openai/gpt-5.2",
      "description": "Designs system components and diagrams.",
      "prompt": "{file:./prompts/architecture.md}"
    },
    "Developer Agent": {
      "model": "openai/gpt-5.2-codex",
      "description": "Implements features based on approved plans.",
      "prompt": "{file:./prompts/dev.md}"
    },
    "Code Reviewer Agent": {
      "model": "openai/gpt-5.2-codex",
      "description": "Reviews code against standards.",
      "prompt": "{file:./prompts/review.md}",
      "tools": { "edit": false, "bash": false }
    },
    "Security Engineer Agent": {
      "model": "openai/gpt-5.2-codex",
      "description": "Audits code for vulnerabilities.",
      "prompt": "{file:./prompts/security.md}"
    },
    "DevOps Engineer Agent": {
      "model": "opencode/minimax-m2.1-free",
      "description": "Manages environment and pipelines.",
      "prompt": "{file:./prompts/devops.md}"
    },
    "QA Engineer Agent": {
      "model": "opencode/minimax-m2.1-free",
      "description": "Generates and runs E2E tests.",
      "prompt": "{file:./prompts/qa.md}"
    },
    "Project Manager Agent": {
      "model": "opencode/minimax-m2.1-free",
      "description": "Tracks status, syncs Jira/Confluence, and manages releases.",
      "prompt": "{file:./prompts/pm.md}"
    }
  }
}
